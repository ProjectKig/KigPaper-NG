     @Override
     public void apply(final ServerLevel serverLevel, final int enchantmentLevel, final EnchantedItemInUse item, final Entity entity, final Vec3 position) {
         Vec3 pos = position.add(this.offset);
-        serverLevel.explode(
+        serverLevel.explode0( // KigPaper
             this.attributeToUser ? entity : null,
             this.getDamageSource(entity, pos),
             new SimpleExplosionDamageCalculator(
@@ -78,7 +78,8 @@ public record ExplodeEffect(
             this.smallParticle,
             this.largeParticle,
             this.blockParticles,
-            this.sound
+            this.sound,
+            e -> e.excludeSourceFromDamage = false // KigPaper
         );
     }
 
